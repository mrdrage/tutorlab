{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TutorLab Session Plan",
  "type": "object",
  "required": ["version", "session_id", "subject", "target_competency_id", "action", "challenge_band", "duration_minutes", "phases"],
  "properties": {
    "version": {"const": "0.1"},
    "session_id": {"type": "string"},
    "subject": {"enum": ["mathematics", "english"]},
    "target_competency_id": {"type": "string"},
    "original_target_id": {"type": "string"},
    "action": {"enum": ["recover", "consolidate", "advance", "extend", "reassess"]},
    "challenge_band": {"type": "integer", "minimum": 1, "maximum": 5},
    "duration_minutes": {"type": "integer", "minimum": 10, "maximum": 120},
    "seed": {"type": "integer"},
    "generation": {"type": "object"},
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["phase_id", "kind", "tasks"],
        "properties": {
          "phase_id": {"type": "string"},
          "kind": {"type": "string"},
          "purpose": {"type": "string"},
          "estimated_minutes": {"type": "integer"},
          "tasks": {"type": "array", "items": {"type": "object"}}
        }
      }
    }
  }
}
