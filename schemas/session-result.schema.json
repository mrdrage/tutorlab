{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TutorLab Session Result",
  "type": "object",
  "required": ["version", "session_id", "completed_at", "completion_status", "responses"],
  "properties": {
    "version": {"const": "0.1"},
    "session_id": {"type": "string"},
    "completed_at": {"type": "string"},
    "completion_status": {"enum": ["completed", "partial", "abandoned"]},
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "response", "status", "support_used"],
        "properties": {
          "task_id": {"type": "string"},
          "response": {},
          "status": {"enum": ["correct", "partially_correct", "incorrect", "not_completed", "needs_external_scoring"]},
          "score": {"type": "number", "minimum": 0, "maximum": 1},
          "support_used": {"enum": ["none", "light_prompt", "structured_prompt", "worked_support", "direct_solution"]},
          "explanation_quality": {"type": "number", "minimum": 0, "maximum": 1},
          "transfer_success": {"type": "number", "minimum": 0, "maximum": 1},
          "tags": {"type": "array", "items": {"type": "string"}},
          "observed_errors": {"type": "array", "items": {"type": "object"}}
        }
      }
    },
    "tutor_notes": {"type": "string"}
  }
}
