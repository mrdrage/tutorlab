{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tutorlab.dev/schemas/academic-context.schema.json",
  "title": "TutorLab Academic Context",
  "description": "Contesto scolastico necessario per interpretare anno, percorso e profilo curricolare senza confonderli con la padronanza dello studente.",
  "type": "object",
  "additionalProperties": false,
  "required": ["school_stage", "stage_year", "school_year"],
  "properties": {
    "school_stage": {"type": "string", "enum": ["middle_school", "upper_secondary"]},
    "stage_year": {"type": "integer", "minimum": 1, "maximum": 5},
    "school_year": {"type": "string", "pattern": "^[0-9]{4}/[0-9]{2}$"},
    "pathway_profile_id": {"type": ["string", "null"], "pattern": "^it\\.upper\\.[a-z0-9._-]+$"},
    "pathway_variant": {"type": ["string", "null"], "enum": [null, "standard", "quadriennale_filiera", "quadriennale_sperimentale", "other_experimental"]},
    "curriculum_profile_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"school_stage": {"const": "middle_school"}}, "required": ["school_stage"]},
      "then": {
        "properties": {
          "stage_year": {"maximum": 3},
          "pathway_profile_id": {"type": "null"},
          "pathway_variant": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"school_stage": {"const": "upper_secondary"}}, "required": ["school_stage"]},
      "then": {
        "required": ["pathway_profile_id", "pathway_variant"],
        "properties": {
          "pathway_profile_id": {"type": "string", "pattern": "^it\\.upper\\.[a-z0-9._-]+$"},
          "pathway_variant": {"type": "string", "enum": ["standard", "quadriennale_filiera", "quadriennale_sperimentale", "other_experimental"]}
        }
      }
    }
  ]
}
