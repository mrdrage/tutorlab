{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tutorlab.dev/schemas/education-pathway.schema.json",
  "title": "TutorLab Education Pathway Catalog",
  "description": "Catalogo versionato dei percorsi della secondaria di secondo grado italiana. Separa struttura del percorso e contenuti curricolari.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "country", "school_stage", "effective_from_school_year", "profiles"],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "country": {"const": "IT"},
    "school_stage": {"const": "upper_secondary"},
    "effective_from_school_year": {"type": "string", "pattern": "^[0-9]{4}/[0-9]{2}$"},
    "effective_to_school_year": {"type": ["string", "null"], "pattern": "^[0-9]{4}/[0-9]{2}$"},
    "status": {"type": "string", "enum": ["current", "transition", "historical", "planned"]},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/profile"}
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "label", "family", "duration_years", "pathway_variant",
        "indirizzo", "effective_from_school_year", "status", "legal_basis"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^it\\.upper\\.[a-z0-9._-]+$"},
        "label": {"type": "string", "minLength": 1},
        "family": {"type": "string", "enum": ["liceo", "tecnico", "professionale"]},
        "duration_years": {"type": "integer", "enum": [4, 5]},
        "pathway_variant": {"type": "string", "enum": ["standard", "quadriennale_filiera", "quadriennale_sperimentale", "other_experimental"]},
        "sector": {"type": ["string", "null"]},
        "indirizzo": {"type": "string", "minLength": 1},
        "articolazione": {"type": ["string", "null"]},
        "opzione": {"type": ["string", "null"]},
        "specializzazione": {"type": ["string", "null"]},
        "parent_profile_id": {"type": ["string", "null"], "pattern": "^it\\.upper\\.[a-z0-9._-]+$"},
        "selection_year": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "effective_from_school_year": {"type": "string", "pattern": "^[0-9]{4}/[0-9]{2}$"},
        "effective_to_school_year": {"type": ["string", "null"], "pattern": "^[0-9]{4}/[0-9]{2}$"},
        "status": {"type": "string", "enum": ["current", "transition", "historical", "planned"]},
        "curriculum_model": {"type": "string", "enum": ["discipline_based", "competency_based", "hybrid"]},
        "notes": {"type": "string"},
        "legal_basis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label"],
            "properties": {
              "label": {"type": "string", "minLength": 1},
              "url": {"type": "string"},
              "effective_note": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
