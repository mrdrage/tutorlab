{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tutorlab.dev/schemas/competency.schema.json",
  "title": "TutorLab Competency",
  "description": "Rappresentazione versionabile di una competenza didattica.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "subject",
    "school_stage",
    "title",
    "typical_years",
    "prerequisites",
    "objectives",
    "key_concepts",
    "common_errors",
    "exercise_families",
    "mastery_evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "default": "0.1.0"
    },
    "subject": {
      "type": "string"
    },
    "school_stage": {
      "type": "string",
      "enum": ["middle_school"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "typical_years": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3
      }
    },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "key_concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "common_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "description", "likely_categories"],
        "properties": {
          "code": { "type": "string" },
          "description": { "type": "string" },
          "likely_categories": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "conceptual_error",
                "missing_prerequisite",
                "procedure_error",
                "execution_error",
                "instruction_comprehension",
                "strategy_selection",
                "attention_lapse",
                "not_automated",
                "persistent_difficulty"
              ]
            }
          }
        }
      }
    },
    "exercise_families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purpose", "difficulty_dimensions"],
        "properties": {
          "id": { "type": "string" },
          "purpose": { "type": "string" },
          "difficulty_dimensions": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "mastery_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "accuracy",
          "autonomy",
          "stability",
          "transfer",
          "explanation",
          "fluency",
          "conceptual_consistency"
        ]
      }
    },
    "next_competencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "remediation_notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "curriculum_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "checked_on"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "checked_on": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
