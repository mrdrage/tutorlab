{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tutorlab.dev/schemas/learner-competency-state.schema.json",
  "title": "TutorLab Learner Competency State",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "competency_id", "mastery", "confidence", "evidence_summary", "updated_at"],
  "properties": {
    "version": {"type": "string", "const": "0.1"},
    "competency_id": {"type": "string", "minLength": 1},
    "mastery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accuracy", "independence", "stability", "transfer", "explanation", "fluency"],
      "properties": {
        "accuracy": {"$ref": "#/$defs/estimate"},
        "independence": {"$ref": "#/$defs/estimate"},
        "stability": {"$ref": "#/$defs/estimate"},
        "transfer": {"$ref": "#/$defs/estimate"},
        "explanation": {"$ref": "#/$defs/estimate"},
        "fluency": {"$ref": "#/$defs/estimate"}
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"type": "string", "enum": ["unknown", "emerging", "developing", "secure", "extended"]},
    "evidence_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_count"],
      "properties": {
        "event_count": {"type": "integer", "minimum": 0},
        "independent_event_count": {"type": "integer", "minimum": 0},
        "transfer_event_count": {"type": "integer", "minimum": 0},
        "recent_success_streak": {"type": "integer", "minimum": 0},
        "recent_failure_streak": {"type": "integer", "minimum": 0},
        "first_observed_at": {"type": "string", "format": "date-time"},
        "last_observed_at": {"type": "string", "format": "date-time"},
        "contradiction_level": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "error_hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "confidence", "persistence", "evidence_for", "evidence_against"],
        "properties": {
          "code": {"type": "string", "enum": ["conceptual_error", "missing_prerequisite", "procedure_error", "execution_error", "instruction_comprehension", "strategy_selection", "attention_lapse", "not_automated", "persistent_difficulty"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "persistence": {"type": "string", "enum": ["single", "repeated", "persistent"]},
          "related_competency_id": {"type": "string"},
          "evidence_for": {"type": "array", "items": {"type": "string"}},
          "evidence_against": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence"],
      "properties": {
        "value": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}