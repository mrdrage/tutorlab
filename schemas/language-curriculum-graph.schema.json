{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tutorlab.dev/schemas/language-curriculum-graph.schema.json",
  "title": "TutorLab Language Curriculum Graph",
  "description": "Schema per curriculum linguistici TutorLab basati su competenze, prerequisiti e profilo QCER.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "subject", "school_stage", "curriculum_profile", "typical_year", "target_cefr", "nodes"],
  "properties": {
    "version": {"type": "string"},
    "subject": {"type": "string", "enum": ["english"]},
    "school_stage": {"type": "string", "enum": ["middle_school"]},
    "curriculum_profile": {"type": "string"},
    "typical_year": {"type": "integer", "minimum": 1, "maximum": 3},
    "target_cefr": {"type": "string", "enum": ["A1", "A2"]},
    "sequencing_note": {"type": "string"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "strand", "typical_year", "priority", "cefr_anchor", "progression_stage", "prerequisites", "objectives", "mastery_evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^eng\\.[a-z0-9._-]+$"},
          "title": {"type": "string", "minLength": 1},
          "strand": {
            "type": "string",
            "enum": [
              "grammar",
              "vocabulary",
              "phonology",
              "reading",
              "listening",
              "spoken_interaction",
              "spoken_production",
              "writing",
              "mediation",
              "intercultural",
              "learning_strategies"
            ]
          },
          "typical_year": {"type": "integer", "minimum": 1, "maximum": 3},
          "priority": {"type": "string", "enum": ["gateway", "core", "supporting", "extension"]},
          "cefr_anchor": {"type": "string", "enum": ["A1", "A2"]},
          "progression_stage": {
            "type": "string",
            "enum": ["A1_core", "A1_to_A2", "A2_core", "A2_extension"]
          },
          "prerequisites": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "objectives": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "mastery_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "diagnostic_signals": {"type": "array", "items": {"type": "string"}},
          "difficulty_levers": {"type": "array", "items": {"type": "string"}},
          "communicative_functions": {"type": "array", "items": {"type": "string"}},
          "contexts": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
