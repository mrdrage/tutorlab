{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tutorlab.dev/schemas/curriculum-graph.schema.json",
  "title": "TutorLab Curriculum Graph",
  "description": "Schema per un grafo disciplinare di competenze e prerequisiti.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "subject", "school_stage", "curriculum_profile", "nodes"],
  "properties": {
    "version": {"type": "string"},
    "subject": {"type": "string"},
    "school_stage": {"type": "string", "enum": ["middle_school"]},
    "curriculum_profile": {"type": "string"},
    "typical_year": {"type": "integer", "minimum": 1, "maximum": 3},
    "sequencing_note": {"type": "string"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "strand", "typical_year", "priority", "prerequisites", "objectives", "mastery_evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^math\\.[a-z0-9._-]+$"},
          "title": {"type": "string", "minLength": 1},
          "strand": {"type": "string", "enum": ["numbers", "geometry", "relations_functions", "data_probability", "mathematical_practices"]},
          "typical_year": {"type": "integer", "minimum": 1, "maximum": 3},
          "priority": {"type": "string", "enum": ["gateway", "core", "supporting", "extension"]},
          "prerequisites": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "objectives": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "mastery_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "diagnostic_signals": {"type": "array", "items": {"type": "string"}},
          "difficulty_levers": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
