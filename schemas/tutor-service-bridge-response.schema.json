{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tutorlab.local/schemas/tutor-service-bridge-response.schema.json",
  "title": "TutorLab JSON Bridge Response",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["bridge_version", "ok", "result"],
      "properties": {
        "bridge_version": {"const": "1.0"},
        "ok": {"const": true},
        "result": {"type": "object"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["bridge_version", "ok", "error"],
      "properties": {
        "bridge_version": {"const": "1.0"},
        "ok": {"const": false},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "type", "message"],
          "properties": {
            "code": {
              "enum": [
                "EMPTY_REQUEST",
                "INVALID_JSON",
                "INVALID_ENVELOPE",
                "INVALID_PAYLOAD",
                "INVALID_SEED",
                "UNSUPPORTED_BRIDGE_VERSION",
                "UNSUPPORTED_OPERATION",
                "TUTORLAB_VALIDATION_ERROR",
                "INTERNAL_ERROR"
              ]
            },
            "type": {"type": "string", "minLength": 1},
            "message": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  ]
}
