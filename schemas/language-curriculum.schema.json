{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tutorlab.dev/schemas/language-curriculum.schema.json",
  "title": "TutorLab Language Curriculum Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "subject", "school_stage", "curriculum_profile", "typical_year", "sequencing_note", "nodes"],
  "properties": {
    "version": {"type": "string"},
    "subject": {"type": "string", "enum": ["english", "italian", "french", "spanish"]},
    "school_stage": {"const": "middle_school"},
    "curriculum_profile": {"type": "string"},
    "typical_year": {"type": "integer", "minimum": 1, "maximum": 3},
    "target_cefr": {"type": "string"},
    "sequencing_note": {"type": "string"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "strand", "typical_year", "priority", "prerequisites", "objectives", "mastery_evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^(eng|ita|fr|es)\\.[a-z0-9._-]+$"},
          "title": {"type": "string", "minLength": 1},
          "strand": {"type": "string", "enum": ["grammar", "vocabulary", "phonology", "reading", "listening", "interaction", "spoken_production", "writing", "mediation", "intercultural", "learning_strategy", "integrated", "oral", "text_analysis", "study_strategy"]},
          "typical_year": {"type": "integer", "minimum": 1, "maximum": 3},
          "priority": {"type": "string", "enum": ["gateway", "core", "supporting", "extension"]},
          "cefr_anchor": {"type": "string"},
          "progression_stage": {"type": "string"},
          "prerequisites": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "objectives": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "mastery_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "diagnostic_signals": {"type": "array", "items": {"type": "string"}},
          "difficulty_levers": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
