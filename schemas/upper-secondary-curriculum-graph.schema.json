{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tutorlab.dev/schemas/upper-secondary-curriculum-graph.schema.json",
  "title": "TutorLab Upper Secondary Curriculum Graph",
  "description": "Grafo curricolare componibile per la secondaria di secondo grado. Un grafo può essere comune oppure un overlay di famiglia, indirizzo, articolazione, opzione o profilo.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "subject", "school_stage", "curriculum_profile", "layer", "nodes"],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "school_stage": {"const": "upper_secondary"},
    "curriculum_profile": {"type": "string", "minLength": 1},
    "effective_from_school_year": {"type": "string", "pattern": "^[0-9]{4}/[0-9]{2}$"},
    "effective_to_school_year": {"type": ["string", "null"], "pattern": "^[0-9]{4}/[0-9]{2}$"},
    "sequencing_note": {"type": "string"},
    "layer": {"$ref": "#/$defs/layer"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/node"}
    }
  },
  "$defs": {
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"type": "string", "enum": ["common_core", "family_core", "indirizzo", "articolazione", "opzione", "profile"]},
        "family": {"type": ["string", "null"], "enum": [null, "liceo", "tecnico", "professionale"]},
        "profile_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^it\\.upper\\.[a-z0-9._-]+$"}
        },
        "notes": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "family_core"}}, "required": ["kind"]},
          "then": {
            "required": ["family"],
            "properties": {"family": {"type": "string", "enum": ["liceo", "tecnico", "professionale"]}}
          }
        },
        {
          "if": {"properties": {"kind": {"enum": ["indirizzo", "articolazione", "opzione", "profile"]}}, "required": ["kind"]},
          "then": {
            "required": ["profile_ids"],
            "properties": {"profile_ids": {"type": "array", "minItems": 1}}
          }
        }
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "strand", "stage_year", "priority", "prerequisites", "objectives", "mastery_evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*\\.us\\.[a-z0-9._-]+$"},
        "title": {"type": "string", "minLength": 1},
        "strand": {"type": "string", "minLength": 1},
        "stage_year": {"type": "integer", "minimum": 1, "maximum": 5},
        "priority": {"type": "string", "enum": ["gateway", "core", "supporting", "extension"]},
        "prerequisites": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*\\.[a-z0-9._-]+$"}
        },
        "objectives": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "mastery_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "diagnostic_signals": {"type": "array", "items": {"type": "string"}},
        "difficulty_levers": {"type": "array", "items": {"type": "string"}},
        "applies_to_profile_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^it\\.upper\\.[a-z0-9._-]+$"}
        },
        "excludes_profile_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^it\\.upper\\.[a-z0-9._-]+$"}
        },
        "notes": {"type": "string"}
      }
    }
  }
}
