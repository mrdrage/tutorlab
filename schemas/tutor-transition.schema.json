{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TutorLab Tutor Transition",
  "type": "object",
  "required": ["version", "subject", "session_id", "snapshot_update", "next_step", "pending_task_ids", "evidence_events", "tutor_summary"],
  "properties": {
    "version": {"const": "1.0-rc1"},
    "subject": {"enum": ["mathematics", "english", "italian", "french", "spanish"]},
    "session_id": {"type": "string"},
    "snapshot_update": {"type": "object"},
    "next_step": {
      "type": "object",
      "required": ["action", "target", "reason"],
      "properties": {
        "action": {"type": "string"},
        "target": {"type": "string"},
        "reason": {"type": "string"}
      },
      "additionalProperties": true
    },
    "pending_task_ids": {"type": "array", "items": {"type": "string"}},
    "evidence_events": {"type": "array", "items": {"type": "object"}},
    "tutor_summary": {
      "type": "object",
      "required": ["evidence_count", "pending_count", "next_action", "next_target"],
      "properties": {
        "evidence_count": {"type": "integer", "minimum": 0},
        "pending_count": {"type": "integer", "minimum": 0},
        "next_action": {"type": "string"},
        "next_target": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
