{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tutorlab.dev/schemas/adaptive-decision.schema.json",
  "title": "TutorLab Adaptive Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "decision_id", "target_competency_id", "action", "confidence", "rationale", "evidence_refs", "created_at"],
  "properties": {
    "version": {"type": "string", "const": "0.1"},
    "decision_id": {"type": "string", "minLength": 1},
    "target_competency_id": {"type": "string", "minLength": 1},
    "action": {"type": "string", "enum": ["recover", "consolidate", "advance", "extend", "reassess"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "rationale": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "primary_hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "confidence"],
      "properties": {
        "code": {"type": "string", "enum": ["conceptual_error", "missing_prerequisite", "procedure_error", "execution_error", "instruction_comprehension", "strategy_selection", "attention_lapse", "not_automated", "persistent_difficulty", "insufficient_evidence", "none"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "related_competency_id": {"type": "string"}
      }
    },
    "next_competency_id": {"type": "string"},
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suspended_target_id", "recovery_competency_id", "return_condition"],
      "properties": {
        "suspended_target_id": {"type": "string", "minLength": 1},
        "recovery_competency_id": {"type": "string", "minLength": 1},
        "return_condition": {"type": "string", "minLength": 1},
        "recovery_depth": {"type": "integer", "minimum": 1},
        "objective_stack": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "reassessment_plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "questions_to_resolve": {"type": "array", "items": {"type": "string"}},
        "evidence_needed": {"type": "array", "items": {"type": "string"}}
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "reason_not_selected"],
        "properties": {
          "action": {"type": "string", "enum": ["recover", "consolidate", "advance", "extend", "reassess"]},
          "reason_not_selected": {"type": "string", "minLength": 1}
        }
      }
    },
    "tutor_override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "reason"],
      "properties": {
        "action": {"type": "string", "enum": ["recover", "consolidate", "advance", "extend", "reassess"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "recover"}}},
      "then": {"required": ["recovery"]}
    },
    {
      "if": {"properties": {"action": {"const": "reassess"}}},
      "then": {"required": ["reassessment_plan"]}
    }
  ]
}