{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"TutorLab Learning Snapshot",
  "type":"object",
  "required":["version","subjects","recent_activity"],
  "properties":{
    "version":{"const":"0.1"},
    "subjects":{"type":"object","additionalProperties":{"type":"object","required":["typical_year","competency_states","evidence_events","objective_stack"],"properties":{"typical_year":{"type":"integer","minimum":1,"maximum":3},"competency_states":{"type":"object","additionalProperties":{"type":"object"}},"evidence_events":{"type":"array","items":{"type":"object"},"maxItems":500},"objective_stack":{"type":["object","null"]},"last_recommendation":{"type":["object","null"]}},"additionalProperties":false}},
    "recent_activity":{"type":"object","required":["session_ids","fingerprints"],"properties":{"session_ids":{"type":"array","items":{"type":"string"}},"fingerprints":{"type":"array","items":{"type":"string"}}},"additionalProperties":false},
    "preferences":{"type":"object"}
  },
  "additionalProperties":false
}
